<!-- attendance module  =>today, yesterday, 2 day ago, 3 daye ago -->

<filter name="today" string="Today" domain="[ ('check_in','&gt;', (context_today() - datetime.timedelta(days=1)).strftime('%%Y-%%m-%%d'))  ,('check_in','&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%%Y-%%m-%%d') )]"/>
<filter name="yesterday" string=" Yesterday " domain="[ ('check_in','&gt;', (context_today() - datetime.timedelta(days=2)).strftime('%%Y-%%m-%%d'))  ,('check_in','&lt;', (context_today() + datetime.timedelta(days=0)).strftime('%%Y-%%m-%%d') )]"/>
<filter name=" 2_days_ago" string="2 Days Ago " domain="[ ('check_in','&gt;', (context_today() - datetime.timedelta(days=3)).strftime('%%Y-%%m-%%d'))  ,('check_in','&lt;', (context_today() - datetime.timedelta(days=1)).strftime('%%Y-%%m-%%d') )]"/>
<filter name=" 3_days_ago" string="3 Days Ago " domain="[ ('check_in','&gt;', (context_today() - datetime.timedelta(days=4)).strftime('%%Y-%%m-%%d'))  ,('check_in','&lt;', (context_today() - datetime.timedelta(days=2)).strftime('%%Y-%%m-%%d') )]"/>