<t t-set="total_counter" t-value="0"/>
            <t t-foreach="docs" t-as="employee">
                <t t-set="total_counter" t-value="total_counter + 1" />
            </t>
            <!-- <t t-esc="total_counter "/> -->


            <div class="container-fluid">
                <div class="row">
                    <t t-set="counter" t-value="0"/>
                    <t t-set="foo" t-value="False"/>
                        <t t-foreach="docs" t-as="employee">
                            <t t-if="foo == False">

                                <div class="col-4" style="height:313pt; width:208pt; border: 1pt solid black; border-collapse:separate; border-radius:2pt; margin:5pt">
                                    <div class="container-fluid p-0">
                                        <div class="row" >
                                            <div class="col-6" style='padding-top:15px; padding-left:15px;'>
                                                <img t-att-src="image_data_uri(employee.avatar_1920)" style='width:100px; height:100px;  border: 1pt solid black; border-radius: 25px;' alt="Employee Image"/>
                                            </div>
                                            <div class="col-6" style=' padding-top:43px; font-size: 15px; padding-right: 15px;'>
                                                Name<br/>
                                                <span style='font-weight: bold; font-style: normal;' t-if="employee.name" t-field="employee.name"/>
                                            </div>
                                        </div>
                                        <div class="row" style='margin-top:15px; border-top:1px solid lightgray; border-bottom:1px solid lightgray; padding: 3px 0px 6px 15px;'>
                                            <img t-if="employee.company_id.logo" t-att-src="image_data_uri(employee.company_id.logo)" style="width:80px; " alt="Company Logo"/>
                                        </div>
                                        <div class="row"  >
                                            <img t-att-src="'/report/barcode/QR/'+employee.barcode" style="display: block; margin-left: auto; margin-right: auto; padding-top:16px;  width:240px; height:240px; " alt="Barcode"/>
                                        </div>
                                    </div>
                                </div>

                            <t t-if="counter==2">
                                <t t-set="foo" t-value="True"/>
                            </t>
                            <t t-set="counter" t-value="counter + 1" />
                        </t>
                    </t>

                </div>
            </div>
            
            <t t-if="total_counter>3">
                <div class="container-fluid">
                    <div class="row">
                        <t t-set="counter" t-value="3"/>
                        <t t-set="foo" t-value="False"/>
                            <t t-foreach="total_counter-3" t-as="employee">
                            <t t-foreach="docs[counter]" t-as="employee">
                                <t t-if="foo == False">
                                <div class="col-4" style="height:313pt; width:208pt; border: 1pt solid black; border-collapse:separate; border-radius:2pt; margin:5pt">
                                    <div class="container-fluid p-0">
                                        <div class="row" >
                                            <div class="col-6" style='padding-top:15px; padding-left:15px;'>
                                                <img t-att-src="image_data_uri(employee.avatar_1920)" style='width:100px; height:100px;  border: 1pt solid black; border-radius: 25px;' alt="Employee Image"/>
                                            </div>
                                            <div class="col-6" style=' padding-top:43px; font-size: 15px; padding-right: 15px;'>
                                                Name<br/>
                                                <span style='font-weight: bold; font-style: normal;' t-if="employee.name" t-field="employee.name"/>
                                            </div>
                                        </div>
                                        <div class="row" style='margin-top:15px; border-top:1px solid lightgray; border-bottom:1px solid lightgray; padding: 3px 0px 6px 15px;'>
                                            <img t-if="employee.company_id.logo" t-att-src="image_data_uri(employee.company_id.logo)" style="width:80px; " alt="Company Logo"/>
                                        </div>
                                        <div class="row"  >
                                            <img t-att-src="'/report/barcode/QR/'+employee.barcode" style="display: block; margin-left: auto; margin-right: auto; padding-top:16px;  width:240px; height:240px; " alt="Barcode"/>
                                        </div>
                                    </div>
                                </div>
                                <t t-if="counter==5">
                                    <t t-set="foo" t-value="True"/>
                                </t>
                                <t t-set="counter" t-value="counter + 1" />
                            </t>
                            </t>
                        </t>
                    </div>
                </div>
            </t>